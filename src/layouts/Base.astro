---
import "../styles/global.css";
const { title = "AI with UI", description = "A filesystem-native workspace your AI agent and your UI share." } = Astro.props;
const site = "https://aiwithui.net";
const canonical = new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="nav">
      <div class="container">
        <a class="brand" href="/">
          <span class="logo">AI</span>
          <span>AI with UI</span>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle-input" hidden />
        <label for="nav-toggle" class="nav-toggle" aria-label="Toggle navigation menu">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </label>
        <nav class="nav-links">
          <a href="/#features">Features</a>
          <a href="/#how">How it works</a>
          <a href="/pricing/">Pricing</a>
          <a href="/docs/">Docs</a>
          <a href="/docs/getting-started/">Get started</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <span>© {new Date().getFullYear()} AI with UI</span>
        <span>
          <a href="/pricing/">Pricing</a> · <a href="/docs/">Docs</a> · <a href="/docs/getting-started/">Get started</a>
        </span>
      </div>
    </footer>
  </body>
</html>
