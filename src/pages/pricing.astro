---
import Base from "../layouts/Base.astro";
const tiers = [
  {
    name: "Community",
    price: "Free",
    tagline: "Self-host the full workspace.",
    features: [
      "Filesystem-native projects — Markdown & JSON, no lock-in",
      "The Studio: dashboards, tables, calendars, boards",
      "Embedded Claude Code / Codex agents in a real terminal",
      "One project per deployment",
      "Optional owner sign-in to keep the Studio private",
      "Encrypted at rest: files, conversations and secrets sealed with AES-256-GCM under your own key",
      "One Docker image, one-click updates",
    ],
    note: "Free to self-host on your own hardware.",
    cta: { label: "Get started", href: "/docs/getting-started/" },
    featured: false,
  },
  {
    name: "Pro",
    price: "License key",
    tagline: "Everything in Community, plus the paid features.",
    features: [
      "Multiple projects, with a project switcher",
      "Browser tools — an agent-driven browser",
      "Secure credential login — the agent signs in to a site without ever seeing the password",
      "First-party connectors: Gmail & Notion — more on the way",
      "Unlock instantly with a license key; no phone-home",
    ],
    note: "Commercial license, on the same image — enter a key to unlock.",
    cta: { label: "Get a license", href: "mailto:hello@aiwithui.net?subject=AI%20with%20UI%20Pro%20license" },
    featured: true,
  },
  {
    name: "Hosted",
    price: "Early access",
    tagline: "We run it for you. You bring your own model key.",
    features: [
      "Managed AI with UI — we handle hosting, updates and backups",
      "Bring your own Anthropic or OpenAI API key — you never pay us for model usage",
      "Your workspace on isolated infrastructure, everything encrypted at rest under its own key",
      "Multiple projects, members with their own logins, and first-party connectors included",
      "Move projects in or out as one zip — no lock-in",
    ],
    note: "Sign up now; new workspaces are approved by hand, usually within a day.",
    cta: { label: "Sign up for hosted", href: "https://app.aiwithui.net/signup" },
    featured: false,
  },
];
---

<Base title="Pricing — AI with UI" description="Free to self-host; Pro features with a license key, or the hosted service where we run it for you.">
  <section class="block">
    <div class="container">
      <div class="section-head">
        <h1>Editions &amp; pricing</h1>
        <p>The core is free to self-host. Unlock Pro features with a license key, or sign up for the hosted service and let us run it.</p>
      </div>
      <div class="grid">
        {
          tiers.map((t) => (
            <div class={t.featured ? "card tier featured" : "card tier"}>
              <h3>{t.name}</h3>
              <p class="price">{t.price}</p>
              <p class="tagline">{t.tagline}</p>
              <ul class="tier-features">
                {t.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <p class="tier-note">{t.note}</p>
              <a class={t.featured ? "btn btn-primary" : "btn btn-ghost"} href={t.cta.href}>
                {t.cta.label}
              </a>
            </div>
          ))
        }
      </div>
      <p class="licensing-note">
        Bringing your own agent means you use your existing Claude Code or Codex subscription when self-hosting,
        and your own Anthropic or OpenAI API key on the hosted service — AI with UI never resells model usage.
        See <a href="/docs/hosted/">how the hosted service works</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .tier {
    display: flex;
    flex-direction: column;
  }
  .price {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2px 0;
  }
  .tagline {
    color: var(--muted, #666);
    margin: 0 0 14px;
  }
  .tier-features {
    margin: 0 0 16px;
    padding-left: 1.1em;
    display: grid;
    gap: 7px;
    flex: 1;
  }
  .tier-note {
    color: var(--muted, #666);
    font-size: 0.9rem;
    margin: 0 0 16px;
  }
  .tier.featured {
    border-color: var(--accent, #0aa17a);
    box-shadow: 0 0 0 1px var(--accent, #0aa17a);
  }
  .tier .btn {
    align-self: flex-start;
  }
  .licensing-note {
    text-align: center;
    color: var(--muted, #666);
    margin-top: 28px;
  }
</style>
