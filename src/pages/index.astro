---
import Base from "../layouts/Base.astro";
const features = [
  { icon: "🗂️", title: "Filesystem-native", body: "A project is just a folder of Markdown and JSON. Your agent reads and writes the same files a person does — no database, no lock-in." },
  { icon: "🖥️", title: "A UI over your files", body: "The Studio renders the folder as dashboards, tables, calendars and boards from a single manifest. Change the file, the UI updates." },
  { icon: "🔌", title: "First-party connectors", body: "Connect Gmail or Notion once. The agent gets read-only tools; the access token stays server-side and is never exposed to it." },
  { icon: "📦", title: "Self-host in one container", body: "One Docker image on a NAS, a VM, or a laptop, with one-click updates. Your data lives in a mounted volume you control." },
  { icon: "👥", title: "Projects and people", body: "Run many projects side by side. Optional user management with an owner and per-user, per-project access — off until you turn it on." },
  { icon: "🔐", title: "Encrypted vault", body: "Credentials and connection tokens are sealed with AES-256-GCM, kept out of Git and out of the agent's reach." },
];
const steps = [
  { title: "Point it at a folder", body: "Give it a project directory. Existing Markdown notes and records just work." },
  { title: "Declare the UI", body: "A short ai-with-ui.yaml maps your files to views: dashboards, tables, calendars." },
  { title: "Work together", body: "Open the Studio, or let a Claude Code / Codex agent edit the same files from its terminal." },
];
---

<Base>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Self-hosted · agent-native workspace</span>
      <h1>One folder your AI agent and your UI both understand.</h1>
      <p class="lead">
        AI with UI turns a plain project folder into a live app — dashboards, tables and calendars
        rendered from your files — that a coding agent can drive from its terminal and a person can use
        from the browser. Self-hosted, encrypted, and yours.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/getting-started/">Get started</a>
        <a class="btn btn-ghost" href="/docs/">Read the docs</a>
      </div>
      <div class="hero-shot">
        <img src="/studio.png" alt="The AI with UI Studio showing a project rendered as a table with subtotals" width="2000" height="1024" loading="eager" />
      </div>
    </div>
  </section>

  <section class="block" id="features">
    <div class="container">
      <div class="section-head">
        <h2>Built for agents and people at once</h2>
        <p>The same files power a clean UI and a capable agent — no sync, no separate database, no export.</p>
      </div>
      <div class="grid">
        {
          features.map((f) => (
            <div class="card">
              <div class="ic">{f.icon}</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="how">
    <div class="container">
      <div class="section-head">
        <h2>How it works</h2>
        <p>The project folder is the source of truth. Everything else is a projection of it.</p>
      </div>
      <div class="steps">
        {
          steps.map((s, i) => (
            <div class="step">
              <div class="n">{i + 1}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="start">
    <div class="container">
      <div class="section-head">
        <h2>Run it in a minute</h2>
        <p>One public image, one compose file. Bring your own folder.</p>
      </div>
      <div class="getstarted">
        <pre><code>services:
  ai-with-ui:
    image: ghcr.io/jmavieira/ai-with-ui:latest
    restart: unless-stopped
    network_mode: host
    environment:
      AIUI_PROJECTS_DIR: /projects
    volumes:
      - ./projects:/projects</code></pre>
        <p style="margin: 16px 0 0; color: var(--muted);">
          Then open the Studio in your browser. Full setup, one-click updates and configuration are in the
          <a href="/docs/getting-started/">getting-started guide</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
