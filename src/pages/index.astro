---
import Base from "../layouts/Base.astro";
const features = [
  { icon: "🗂️", title: "Filesystem-native", body: "A project is just a folder of Markdown and JSON. Your agent reads and writes the same files a person does — no database, no lock-in." },
  { icon: "🖥️", title: "A UI over your files", body: "The Studio renders the folder as dashboards, tables, boards, timelines, calendars, checklists, priority matrices, photo galleries and maps from a single manifest. Change the file, the UI updates." },
  { icon: "🔌", title: "First-party connectors", body: "Connect Gmail or Notion — with more connectors on the way. The agent gets read-only tools; the access token stays server-side, never exposed to it. (Pro)" },
  { icon: "📦", title: "Self-host, or let us host it", body: "One Docker image on a NAS, a VM, or a laptop, with one-click updates — or sign up for the hosted service and bring your own model key. Projects move between the two as one zip." },
  { icon: "🔑", title: "Sign-in and projects", body: "Optional owner sign-in keeps the Studio private on a shared network. Running many projects side by side, with a project switcher, is a Pro feature." },
  { icon: "🔐", title: "Encrypted at rest", body: "Everything the service stores is sealed with AES-256-GCM under a key that exists only for your workspace: project files, agent conversations, credentials and connection tokens. A copy of the database reveals none of it." },
];
const views = [
  { img: "/screens/board.png", title: "Boards", body: "Work moving through stages, a column per status. Tasks, shortlists, applications." },
  { img: "/screens/timeline.png", title: "Timelines", body: "Everything with a date, in order, with today marked and the past faded. Itineraries, events, visits." },
  { img: "/screens/gallery.jpg", title: "Galleries", body: "Picture cards for things you recognise by sight. Places, restaurants, products, wardrobe." },
  { img: "/screens/map.jpg", title: "Maps", body: "Records with coordinates on a map, numbered and listed, each one a click away." },
  { img: "/screens/calendar.png", title: "Calendars", body: "Trips, itinerary items and events on one calendar, each type in its own colour." },
  { img: "/screens/dashboard.png", title: "Dashboards", body: "Countdowns to what is next, spending against a budget, and the lists that need you." },
];
const videos = [
  {
    src: "/videos/ai-with-ui-work.mp4",
    poster: "/videos/ai-with-ui-work.jpg",
    title: "Boards, a priority matrix and a checklist",
    body: "Drag a task to another column and its status is saved. Overdue and upcoming dates are flagged, a matrix sorts work by importance and urgency, and the shopping list is ticked off aisle by aisle.",
  },
  {
    src: "/videos/ai-with-ui-links.mp4",
    poster: "/videos/ai-with-ui-links.jpg",
    title: "Records that connect",
    body: "Every record lists what links to it, with a timeline of the dated ones. Counts and totals are calculated from linked records, long records fold into sections, and a small line shows how a price changed.",
  },
  {
    src: "/videos/ai-with-ui-agent.mp4",
    poster: "/videos/ai-with-ui-agent.jpg",
    title: "The agent at work",
    body: "Asked in plain language to pick a hotel, the agent compares the options against the traveller's profile, updates the records and adds a booking task. Every edit can be reviewed line by line and reverted.",
  },
  {
    src: "/videos/ai-with-ui-schedules.mp4",
    poster: "/videos/ai-with-ui-schedules.jpg",
    title: "Scheduled actions that send email",
    body: "Ask for a weekday summary and the agent sets up the schedule itself. Each run starts on the server as its own session, reads the tasks and bookings, and emails the summary, with every step visible.",
  },
];
const controls = [
  "Every value shown for what it is: money with its currency, dates in words, links, stars, photos, and linked records by name",
  "Change the status from a dropdown, or drag a card to another column on a board",
  "Set a rating with a click, and change a quantity with + and −",
  "Tick checklist items right in the record",
  "Log a visit — date, rating, spend, would you go back — in one short form",
  "Every change saved safely: an edit made elsewhere in the meantime is never overwritten",
];
const steps = [
  { title: "Point it at a folder", body: "Give it a project directory. Existing Markdown notes and records just work." },
  { title: "Your agent declares the UI", body: "Tell your agent what you want to see and it writes the short ai-with-ui.yaml that maps your files to views — dashboards, tables, calendars. No hand-written YAML." },
  { title: "Work together", body: "Open the Studio, or let a Claude Code / Codex agent edit the same files from its terminal." },
];
---

<Base>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Self-hosted or hosted · agent-native workspace</span>
      <h1>One folder your AI agent and your UI both understand.</h1>
      <p class="lead">
        AI with UI turns a plain project folder into a live app — dashboards, tables, boards, timelines,
        galleries and maps rendered from your files — that an AI agent keeps up to date and a person can use
        from the browser. Self-hosted or hosted, encrypted at rest, and yours.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://app.aiwithui.net/signup">Sign up for hosted</a>
        <a class="btn btn-ghost" href="/docs/getting-started/">Self-host it</a>
        <a class="btn btn-ghost" href="/docs/">Read the docs</a>
      </div>
      <div class="hero-shot">
        <img src="/studio.png" alt="The AI with UI Studio showing a project rendered as a table with subtotals" width="2000" height="1024" loading="eager" />
      </div>
    </div>
  </section>

  <section class="block" id="features">
    <div class="container">
      <div class="section-head">
        <h2>Built for agents and people at once</h2>
        <p>The same files power a clean UI and a capable agent — no sync, no separate database, no export.</p>
      </div>
      <div class="grid">
        {
          features.map((f) => (
            <div class="card">
              <div class="ic">{f.icon}</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="in-action">
    <div class="container">
      <div class="section-head">
        <h2>See it in action</h2>
        <p>Short tours recorded in the Studio on example projects: the newest views first, then the agent at work.</p>
      </div>
      <div class="showcase">
        {
          videos.map((v) => (
            <figure class="shot">
              <video controls playsinline preload="none" poster={v.poster} width="1280" height="800">
                <source src={v.src} type="video/mp4" />
              </video>
              <figcaption>
                <strong>{v.title}.</strong> {v.body}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="views">
    <div class="container">
      <div class="section-head">
        <h2>Your data, shown the way it works</h2>
        <p>
          The agent picks the view that fits each kind of record, from the same files. Tables are always there
          for sorting and totals; these come on top.
        </p>
      </div>
      <div class="showcase">
        {
          views.map((v) => (
            <figure class="shot">
              <img src={v.img} alt={`${v.title} in the AI with UI Studio`} width="1806" height="1350" loading="lazy" />
              <figcaption>
                <strong>{v.title}</strong> {v.body}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="records">
    <div class="container">
      <div class="records">
        <div class="records-copy">
          <h2>Records you can act on</h2>
          <p>
            Each record opens as a page: its photo first, the key facts, buttons for its website, phone and map, and the
            notes the agent keeps. And you don't need the agent for the small things.
          </p>
          <ul class="ticks">
            {controls.map((c) => <li>{c}</li>)}
          </ul>
          <img class="checklist-shot" src="/screens/checklist.png" alt="A packing checklist ticked on a record page" width="1191" height="450" loading="lazy" />
        </div>
        <figure class="shot record-shot">
          <img src="/screens/record.jpg" alt="A trip's record page with its photo, status, dates and budget" width="1191" height="1464" loading="lazy" />
        </figure>
      </div>
    </div>
  </section>

  <section class="block" id="security">
    <div class="container">
      <div class="section-head">
        <h2>Encrypted at rest, by default</h2>
        <p>
          Every workspace gets its own encryption key. Project files, agent conversations, credentials and
          connection tokens are sealed with AES-256-GCM before they are written, and session ids are stored only
          as digests. A backup, a database dump or an administrator's console yields no file, no conversation and
          no usable login without the deployment's key. Self-hosting, that key is yours alone: set one variable
          and nothing readable ever touches the disk. <a href="/docs/hosted/#your-data">How it works</a>
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="how">
    <div class="container">
      <div class="section-head">
        <h2>How it works</h2>
        <p>The project folder is the source of truth. Everything else is a projection of it.</p>
      </div>
      <div class="steps">
        {
          steps.map((s, i) => (
            <div class="step">
              <div class="n">{i + 1}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block" id="start">
    <div class="container">
      <div class="section-head">
        <h2>Run it in a minute</h2>
        <p>One public image, one compose file. Bring your own folder — free and self-hosted. Or skip the container entirely with the <a href="/docs/hosted/">hosted service</a>.</p>
      </div>
      <div class="getstarted">
        <pre><code>services:
  ai-with-ui:
    image: ghcr.io/jmavieira/ai-with-ui:latest
    restart: unless-stopped
    network_mode: host
    environment:
      AIUI_PROJECT: /project
    volumes:
      - ./my-project:/project</code></pre>
        <p style="margin: 16px 0 0; color: var(--muted);">
          Then open the Studio in your browser. Full setup and one-click updates are in the
          <a href="/docs/getting-started/">getting-started guide</a>. Running many projects at once is a
          <a href="/pricing/">Pro feature</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="block" id="editions">
    <div class="container">
      <div class="section-head">
        <h2>Free to self-host. Hosted when you'd rather not run it.</h2>
        <p>
          Self-hosting is free, with every feature: multiple projects, browser tools and first-party
          connectors included, no license key. The hosted service runs the whole thing for you, on your own
          Anthropic or OpenAI API key — sign up, confirm your email, import your projects.
        </p>
      </div>
      <div class="hero-cta" style="justify-content: center;">
        <a class="btn btn-primary" href="/pricing/">See editions &amp; pricing</a>
        <a class="btn btn-ghost" href="https://app.aiwithui.net/signup">Sign up for hosted</a>
      </div>
    </div>
  </section>

  <section class="block" id="about">
    <div class="container">
      <div class="section-head">
        <h2>Who's behind it</h2>
        <p>
          AI with UI is built and run by <a href="https://startcut.dev/" rel="noopener">StartCut</a>, fractional
          CTOs and embedded engineering squads for AI startups. StartCut also operates the hosted service.
        </p>
      </div>
    </div>
  </section>
</Base>
