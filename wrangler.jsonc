{
  // aiwithui.net on Cloudflare Workers: static assets from ./dist, plus a tiny
  // Worker (worker/index.js) that handles POST /api/contact for the support form.
  // `npm run build` produces ./dist, then `npm run deploy` uploads both.
  "name": "aiwithui-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Support-form submissions are sent through Resend (the same account the
  // Studio uses). RESEND_API_KEY is a secret set on the Cloudflare project,
  // never committed; locally it goes in .dev.vars.
  // Cloudflare's rate limiter for the support form: 5 submissions a minute per
  // client IP (namespace_id is any number unique to this account).
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "CONTACT_TO": "info@aiwithui.net",
    "CONTACT_FROM": "noreply@aiwithui.net"
  }
}
